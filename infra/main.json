                },
                "template": {
                  "containers": [
                    {
                      "name": "api",
                      "image": "[parameters('containerImage')]",
                      "resources": {
                        "cpu": "[json('0.5')]",
                        "memory": "1Gi"
                      },
                      "env": [
                        {
                          "name": "AZURE_CLIENT_ID",
                          "value": "[reference('identity').clientId]"
                        },
                        {
                          "name": "EntraID__Instance",
                          "value": "[environment().authentication.loginEndpoint]"
                        },
                        {
                          "name": "EntraID__TenantID",
                          "value": "[parameters('entraTenantId')]"
                        },
                        {
                          "name": "EntraID__ClientID",
                          "value": "[reference('apiApp').appId]"
                        },
                        {
                          "name": "Cors__AllowedOrigins__0",
                          "value": "[format('https://{0}', reference('staticWebApp').defaultHostname)]"
                        },
                        {
                          "name": "Cosmos__AccountEndpoint",
                          "value": "[reference('cosmos').documentEndpoint]"
                        },
                        {
                          "name": "Cosmos__DatabaseName",
                          "value": "[variables('databaseName')]"
                        },
                        {
                          "name": "Cosmos__ContainerName",
                          "value": "[variables('containerName')]"
                        },
                        {
                          "name": "ServiceBus__FullyQualifiedNamespace",
                          "value": "[format('{0}.servicebus.windows.net', variables('serviceBusName'))]"
                        },
                        {
                          "name": "ServiceBus__GraphEventsTopic",
                          "value": "[variables('eventTopicName')]"
                        },
                        {
                          "name": "ServiceBus__RecommendationQueue",
                          "value": "[variables('recommendationQueueName')]"
                        },
                        {
                          "name": "ServiceBus__ReviewSubscription",
                          "value": "[variables('reviewSubscriptionName')]"
                        },
                        {
                          "name": "Foundry__ProjectEndpoint",
                          "value": "[variables('foundryProjectEndpoint')]"
                        },
                        {
                          "name": "Foundry__ModelDeploymentName",
                          "value": "[parameters('foundryModelDeploymentName')]"
                        },
                        {
                          "name": "Foundry__ModelIdentity",
                          "value": "[parameters('foundryModelIdentity')]"
                        },
                        {
                          "name": "WorkspaceAuthorizationJson",
                          "value": "[string(createObject('workspaces', createObject(format('workspace-{0}', parameters('environmentName')), createObject('facilitatorGroupObjectIds', createArray(reference('facilitatorGroup').id), 'reviewerGroupObjectIds', createArray(reference('reviewerGroup').id)))))]"
                        },
                        {
                          "name": "FabricJson",
                          "value": "[string(parameters('fabricGovernance'))]"
                        },
                        {
                          "name": "Guardrails__Mode",
                          "value": "[parameters('guardrailMode')]"
                        },
                        {
                          "name": "Guardrails__ApprovedBy",
                          "value": "[parameters('guardrailApprovedBy')]"
                        },
                        {
                          "name": "Guardrails__RollbackReference",
                          "value": "[parameters('guardrailRollbackReference')]"
                        },
                        {
                          "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                          "value": "[reference('insights').ConnectionString]"
                        },
                        {
                          "name": "SignalR__Endpoint",
                          "value": "[format('https://{0}', reference('signalR').hostName)]"
                        },
                        {
                          "name": "Participant__SigningKey",
                          "secretRef": "participant-signing-key"
                        }
                      ],
                      "probes": [
                        {
                          "type": "Liveness",
                          "httpGet": {
                            "path": "/health/live",
                            "port": 8080,
                            "scheme": "HTTP"
                          },
                          "initialDelaySeconds": 10,
                          "periodSeconds": 30,
                          "timeoutSeconds": 5,
                          "failureThreshold": 3
                        },
                        {
                          "type": "Readiness",
                          "httpGet": {
                            "path": "/health/ready",
                            "port": 8080,
                            "scheme": "HTTP"
                          },
                          "initialDelaySeconds": 15,
                          "periodSeconds": 30,
                          "timeoutSeconds": 10,
                          "failureThreshold": 3
                        }
                      ]
                    }
                  ],
                  "scale": {
                    "minReplicas": 1,
                    "maxReplicas": 10,
                    "rules": [
                      {
                        "name": "http-concurrency",
                        "http": {
                          "metadata": {
                            "concurrentRequests": "20"
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "dependsOn": [
                "apiApp",
                "containerEnvironment",
                "containerRegistry",
                "cosmos",
                "cosmosDataRole",
                "eventTopic",
                "facilitatorGroup",
                "foundryDeveloperRole",
                "identity",
                "insights",
                "keyVaultSecretsUserRole",
                "participantSigningKeySecret",
                "recommendationQueue",
                "reviewerGroup",
                "reviewSubscription",
                "serviceBus",
                "serviceBusReceiverRole",
                "serviceBusSenderRole",
                "signalR",
                "signalRAppServerRole",
                "staticWebApp"
              ]
            },
            "staticWebApp": {
              "type": "Microsoft.Web/staticSites",
              "apiVersion": "2024-04-01",
              "name": "[format('stapp-oe-{0}', parameters('environmentName'))]",
              "location": "eastasia",
              "tags": "[union(parameters('tags'), createObject('azd-service-name', 'web'))]",
              "sku": {
                "name": "Free",
                "tier": "Free"
              },
              "properties": {
                "buildProperties": {
                  "skipGithubActionWorkflowGeneration": true
                }
              }
            }
          },
          "outputs": {
            "apiUri": {
              "type": "string",
              "value": "[format('https://{0}', reference('app').configuration.ingress.fqdn)]"
            },
            "AZURE_CONTAINER_REGISTRY_ENDPOINT": {
              "type": "string",
              "value": "[reference('containerRegistry').loginServer]"
            },
            "AUTH_CLIENT_ID": {
              "type": "string",
              "value": "[reference('apiApp').appId]"
            },
            "AUTH_SCOPE": {
              "type": "string",
              "value": "[format('api://opportunity-engineering-{0}/access_as_user', parameters('environmentName'))]"
            },
            "FACILITATOR_GROUP_ID": {
              "type": "string",
              "value": "[reference('facilitatorGroup').id]"
            },
            "WEB_URI": {
              "type": "string",
              "value": "[format('https://{0}', reference('staticWebApp').defaultHostname)]"
            },
            "STATIC_WEB_APP_NAME": {
              "type": "string",
              "value": "[format('stapp-oe-{0}', parameters('environmentName'))]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', variables('resourceGroupName'))]"
      ]
    }
  ],
  "outputs": {
